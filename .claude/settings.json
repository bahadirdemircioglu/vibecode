{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(make verify*)",
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(make format*)",
      "Bash(make audit*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose exec * pytest*)",
      "Bash(docker compose exec * npm test*)",
      "Bash(docker compose exec * ruff*)",
      "Bash(.vibecode/scripts/deepseek-debate.js*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -df*)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Bash(chmod -R 777*)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Bash(*> .env*)",
      "Bash(cat *.env*)",
      "Bash(pip install*)",
      "Bash(npm install*)",
      "Read(**/.env)",
      "Read(**/.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-tool-use.js",
            "description": "Single process per write/fetch: net-fs-guard (SSRF + system-path & symlink-escape containment, fail-closed; VIBE_ALLOW_PRIVATE_FETCH=1 allows local fetch) + advisory skill hint once per path per session"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/permission-policy.js",
            "description": "Risk-tier permission gate for Bash: hard-blocks destructive commands (rm -rf in any flag order, force push, curl|bash, fork bombs), warns on standard-risk ops. VIBE_YOLO=1 downgrades blocks."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notification.js",
            "description": "Per-turn context monitor — warns at ~60K/80K token thresholds (per session)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "description": "Show session state and detect project gaps on startup"
          }
        ]
      }
    ]
  }
}
