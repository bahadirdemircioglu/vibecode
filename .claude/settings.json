{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(make verify*)",
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(make format*)",
      "Bash(make audit*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose exec * pytest*)",
      "Bash(docker compose exec * npm test*)",
      "Bash(docker compose exec * ruff*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -df*)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Bash(chmod -R 777*)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Bash(*> .env*)",
      "Bash(cat *.env*)",
      "Bash(pip install*)",
      "Bash(npm install*)",
      "Bash(python *)",
      "Bash(node *)",
      "Read(**/.env)",
      "Read(**/.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use.js",
            "description": "Advisory: checks if relevant standard was loaded before writing code"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|Read|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/permission-policy.js",
            "description": "Risk-tier permission gate: hard-blocks destructive actions (rm -rf, force push, curl|bash, fork bombs), warns on standard-risk ops. VIBE_YOLO=1 downgrades blocks."
          }
        ]
      },
      {
        "matcher": "WebFetch|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/net-fs-guard.js",
            "description": "SSRF guard (blocks private/loopback fetch targets) + system-path & symlink-escape containment for writes. VIBE_ALLOW_PRIVATE_FETCH=1 allows local fetch."
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notification.js",
            "description": "Monitors context size and warns at 60K/80K token thresholds"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh",
            "description": "Show session state and detect project gaps on startup"
          }
        ]
      }
    ]
  }
}
