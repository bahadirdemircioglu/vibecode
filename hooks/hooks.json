{
  "description": "vibecode hooks — active only in projects initialized with /vibecode:init (a .vibecode/ directory at the project root)",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"" } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|WebFetch",
        "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-node.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use.js\"" } ]
      },
      {
        "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-node.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/permission-policy.js\"" } ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-node.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/notification.js\"" } ] }
    ]
  }
}
