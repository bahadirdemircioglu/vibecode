# OS
.DS_Store
Thumbs.db

# Worktrees (temporary)
.claude/worktrees/

# Serena (auto-generated per project, not part of template)
.serena/

# Continuous-doc-maintainer idempotency state (local cache, not repo content)
.vibecode/state/

# SDD runtime workspace (task briefs, diff packages, progress ledger — local only)
