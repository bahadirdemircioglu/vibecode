# vibeplan, outside any repo). This entry only covers the optional project-local override.
# Only providers.env.example is tracked.
.vibecode/providers.env
._*

# Secrets — app env files (only the placeholder template is tracked)
.env
.env.*
!.env.example

# Local DB dumps (.vibecode/scripts/db-backup.sh)
backups/

# Claude Code per-user local settings
.claude/settings.local.json
