#!/usr/bin/env bash
# vibe-update — sync vibecode FRAMEWORK files into a derived project from
# upstream GitHub, using hash-based 3-way classification (base/current/upstream).
#
# The script is the MECHANICAL half of /vibe-update: it fetches, classifies and
# applies the clean buckets. Interactive CONFLICT resolution is left to Claude
# (the /vibe-update command), matching the repo's file-handoff philosophy.
#
# Subcommands:
#   scan            fetch upstream + classify → report + plan.tsv (no project writes)
#   apply-clean     copy UPDATE+ADD entries into the project (refuses on dirty tree)
#   apply-one PATH  copy a single upstream file over the local one (accept-theirs)
#   write-manifest  regenerate the baseline manifest from current framework files
#   init            write a baseline manifest from current files (bootstrap; sha=unknown)
#
# Exit codes: 0 ok · 2 missing dep · 3 running inside vibecode source · 4 dirty tree
#
# Env overrides: VIBECODE_ORIGIN (owner/repo), VIBECODE_REF (branch/tag).

set -uo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
STATE_DIR="$PROJECT_ROOT/.vibecode/state"
MANIFEST="$PROJECT_ROOT/.vibecode/VERSION"
REPORT="$STATE_DIR/update-report.md"
PLAN="$STATE_DIR/update-plan.tsv"
UPSTREAM_ROOT_FILE="$STATE_DIR/upstream-root"
UPSTREAM_SHA_FILE="$STATE_DIR/upstream-sha"

DEFAULT_ORIGIN="bahadirdemircioglu/vibecode"

# Framework paths: updated by /vibe-update. Everything else is the user's.
FRAMEWORK_PATHS=(
  ".vibecode/standards" ".vibecode/skills" ".vibecode/scripts"
  ".vibecode/prompts" ".vibecode/templates" ".vibecode/providers.env.example"
  ".claude/hooks" ".claude/commands" ".claude/agents" ".claude/rules"
  "CLAUDE.md"
)
# Ambiguous: user may customize → always treated as CONFLICT (never silent update).
# Entries may be files or directories (a directory covers every file below it).
# .vibecode/config holds per-project choices (provider enabled/model/limits).
AMBIGUOUS_PATHS=(".claude/settings.json" ".gitignore" ".vibecode/config")

# ---- helpers ----------------------------------------------------------------

sha256() { # <file> → hex digest (empty if file missing)
  [[ -f "$1" ]] || return 0
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  elif command -v shasum   >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  else echo "NOHASH"; fi
}

manifest_get() { # <header-key> → value (before the "--- files ---" divider)
  [[ -f "$MANIFEST" ]] || return 1
  awk -F'\t' -v k="$1" '/^--- files ---$/{exit} $1==k{print $2; exit}' "$MANIFEST"
}

manifest_hash() { # <relpath> → baseline hash (empty if not recorded)
  [[ -f "$MANIFEST" ]] || return 0
  awk -F'\t' -v p="$1" 'f && $1==p{print $2; exit} /^--- files ---$/{f=1}' "$MANIFEST"
}

is_ambiguous() { local p="$1" a; for a in "${AMBIGUOUS_PATHS[@]}"; do [[ "$p" == "$a" || "$p" == "$a/"* ]] && return 0; done; return 1; }

# List files (relative paths) under a framework path within a given root.
enum_files() { # <root> <relpath>
  local root="$1" rel="$2"
  if [[ -f "$root/$rel" ]]; then printf '%s\n' "$rel"
  elif [[ -d "$root/$rel" ]]; then ( cd "$root" && find "$rel" -type f 2>/dev/null ); fi
}

resolve_origin() { manifest_get origin 2>/dev/null || echo "$DEFAULT_ORIGIN"; }
resolve_ref()    { manifest_get ref    2>/dev/null || echo "main"; }

# ---- subcommands ------------------------------------------------------------

cmd_scan() {
  local origin ref
  origin="${VIBECODE_ORIGIN:-$(resolve_origin)}"
  ref="${VIBECODE_REF:-$(resolve_ref)}"

  # Self-guard: never try to update the vibecode source repo from itself.
  local origin_url
  origin_url="$(git -C "$PROJECT_ROOT" remote get-url origin 2>/dev/null || true)"
  if [[ -n "$origin_url" && "$origin_url" == *"$origin"* ]]; then
    echo "SELF: origin ($origin_url) is the vibecode source — nothing to update."
    exit 3
  fi

  mkdir -p "$STATE_DIR"
  local uroot sha

  if [[ -n "${VIBECODE_UPSTREAM_DIR:-}" ]]; then
    # Local-source mode: use a local vibecode clone/dir directly (no network).
    # Also the offline test hook. Skips curl/tar and the SHA lookup.
    [[ -d "$VIBECODE_UPSTREAM_DIR" ]] || { echo "ERROR: VIBECODE_UPSTREAM_DIR not a directory"; exit 2; }
    uroot="$VIBECODE_UPSTREAM_DIR"
    sha="$(git -C "$uroot" rev-parse --short HEAD 2>/dev/null || echo local)"
  else
    command -v curl >/dev/null 2>&1 || { echo "MISSING: curl"; exit 2; }
    command -v tar  >/dev/null 2>&1 || { echo "MISSING: tar";  exit 2; }
    local up="$STATE_DIR/upstream"
    rm -rf "$up"; mkdir -p "$up"
    echo "Fetching $origin@$ref ..."
    if ! curl -fsSL "https://codeload.github.com/$origin/tar.gz/refs/heads/$ref" | tar -xz -C "$up" 2>/dev/null; then
      echo "ERROR: failed to fetch/extract tarball for $origin@$ref"; exit 2
    fi
    uroot="$(find "$up" -mindepth 1 -maxdepth 1 -type d | head -1)"
    [[ -d "$uroot" ]] || { echo "ERROR: extracted tree not found"; exit 2; }
    # Best-effort upstream commit SHA (records what we synced to).
    sha="$(curl -fsSL -H 'Accept: application/vnd.github+json' \
          "https://api.github.com/repos/$origin/commits/$ref" 2>/dev/null \
          | grep -m1 '"sha"' | sed 's/.*"sha": *"\([^"]*\)".*/\1/')"
    sha="${sha:-unknown}"
  fi
  printf '%s' "$uroot" > "$UPSTREAM_ROOT_FILE"
  printf '%s' "$sha"   > "$UPSTREAM_SHA_FILE"

  # Build the candidate relpath set (union of local + upstream framework files).
  local tmp_list; tmp_list="$(mktemp)"
  local p
  for p in "${FRAMEWORK_PATHS[@]}" "${AMBIGUOUS_PATHS[@]}"; do
    enum_files "$PROJECT_ROOT" "$p"
    enum_files "$uroot" "$p"
  done | sort -u > "$tmp_list"

  : > "$PLAN"
  local n_update=0 n_add=0 n_conflict=0 n_deleted=0 n_useradd=0 n_useronly=0
  local rel cur uph base
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    cur="$(sha256 "$PROJECT_ROOT/$rel")"
    uph="$(sha256 "$uroot/$rel")"
    base="$(manifest_hash "$rel")"

    if [[ -z "$uph" && -n "$cur" ]]; then
      if [[ -n "$base" ]]; then printf 'DELETED\t%s\n' "$rel" >> "$PLAN"; ((n_deleted++))
      else printf 'USERADD\t%s\n' "$rel" >> "$PLAN"; ((n_useradd++)); fi
      continue
    fi
    if [[ -z "$cur" && -n "$uph" ]]; then printf 'ADD\t%s\n' "$rel" >> "$PLAN"; ((n_add++)); continue; fi
    [[ "$cur" == "$uph" ]] && continue   # identical → nothing to do

    if is_ambiguous "$rel"; then printf 'CONFLICT\t%s\n' "$rel" >> "$PLAN"; ((n_conflict++)); continue; fi
    if   [[ "$base" == "$cur" ]]; then printf 'UPDATE\t%s\n'   "$rel" >> "$PLAN"; ((n_update++))
    elif [[ "$uph"  == "$base" ]]; then printf 'USERONLY\t%s\n' "$rel" >> "$PLAN"; ((n_useronly++))
    else printf 'CONFLICT\t%s\n' "$rel" >> "$PLAN"; ((n_conflict++)); fi
  done < "$tmp_list"
  rm -f "$tmp_list"

  # Human-readable report.
  {
    echo "# vibecode framework update — $origin@$ref"
    echo
    echo "- Upstream SHA: $(cat "$UPSTREAM_SHA_FILE")"
    echo "- Baseline manifest: $([[ -f "$MANIFEST" ]] && echo present || echo "MISSING — no baseline, so user edits cannot be told apart from upstream changes: every file that differs from upstream is reported as CONFLICT (nothing is auto-applied). After resolving, run 'vibe-update write-manifest' to record a baseline.")"
    echo "- Generated: $(date '+%Y-%m-%d %H:%M')"
    echo
    echo "## Summary"
    echo "| Bucket | Count | Action |"
    echo "|--------|-------|--------|"
    echo "| UPDATE   | $n_update   | auto-apply (user untouched, upstream changed) |"
    echo "| ADD      | $n_add      | auto-apply (new upstream file) |"
    echo "| CONFLICT | $n_conflict | ask (both changed / ambiguous) |"
    echo "| USERONLY | $n_useronly | leave (only user changed) |"
    echo "| USERADD  | $n_useradd  | leave (user-created file) |"
    echo "| DELETED  | $n_deleted  | leave + report (upstream removed) |"
    local b
    for b in UPDATE ADD CONFLICT DELETED; do
      if grep -q "^$b"$'\t' "$PLAN"; then
        echo; echo "### $b"
        awk -F'\t' -v b="$b" '$1==b{print "- " $2}' "$PLAN"
      fi
    done
  } > "$REPORT"

  [[ -f "$MANIFEST" ]] || echo "WARN: no baseline manifest (.vibecode/VERSION) — every differing file is classified CONFLICT; run 'write-manifest' after resolving."
  echo "SCAN OK — UPDATE=$n_update ADD=$n_add CONFLICT=$n_conflict USERONLY=$n_useronly USERADD=$n_useradd DELETED=$n_deleted"
  echo "REPORT: $REPORT"
  echo "PLAN:   $PLAN"
}

_framework_dirty() { # → nonzero exit + prints dirty paths if framework tree is dirty
  git -C "$PROJECT_ROOT" rev-parse --git-dir >/dev/null 2>&1 || return 0
  git -C "$PROJECT_ROOT" status --porcelain -- "${FRAMEWORK_PATHS[@]}" "${AMBIGUOUS_PATHS[@]}" 2>/dev/null
}

cmd_apply_clean() {
  [[ -f "$PLAN" ]] || { echo "ERROR: no plan — run 'scan' first"; exit 2; }
  local dirty; dirty="$(_framework_dirty)"
  if [[ -n "$dirty" ]]; then
    echo "DIRTY: framework paths have uncommitted changes — commit or stash first:"; echo "$dirty"; exit 4
  fi
  local uroot; uroot="$(cat "$UPSTREAM_ROOT_FILE" 2>/dev/null)"
  [[ -d "$uroot" ]] || { echo "ERROR: upstream tree missing — run 'scan' first"; exit 2; }
  local applied=0 bucket rel
  while IFS=$'\t' read -r bucket rel; do
    case "$bucket" in
      UPDATE|ADD)
        mkdir -p "$PROJECT_ROOT/$(dirname "$rel")"
        cp "$uroot/$rel" "$PROJECT_ROOT/$rel" && { echo "  applied: $rel"; ((applied++)); }
        ;;
    esac
  done < "$PLAN"
  echo "APPLIED $applied clean file(s)."
}

cmd_apply_one() { # <relpath> — accept upstream version for a resolved conflict
  local rel="${1:?usage: apply-one <path>}"
  local uroot; uroot="$(cat "$UPSTREAM_ROOT_FILE" 2>/dev/null)"
  [[ -f "$uroot/$rel" ]] || { echo "ERROR: no upstream file for $rel"; exit 2; }
  mkdir -p "$PROJECT_ROOT/$(dirname "$rel")"
  cp "$uroot/$rel" "$PROJECT_ROOT/$rel" && echo "  accepted upstream: $rel"
}

cmd_write_manifest() {
  local origin ref sha
  origin="${VIBECODE_ORIGIN:-$(resolve_origin)}"
  ref="${VIBECODE_REF:-$(resolve_ref)}"
  sha="$(cat "$UPSTREAM_SHA_FILE" 2>/dev/null || echo unknown)"
  mkdir -p "$(dirname "$MANIFEST")"
  {
    echo "# vibecode framework manifest — auto-generated, do not edit by hand"
    printf 'origin\t%s\n' "$origin"
    printf 'ref\t%s\n' "$ref"
    printf 'sha\t%s\n' "$sha"
    printf 'updated\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')"
    echo "--- files ---"
    local p rel
    for p in "${FRAMEWORK_PATHS[@]}" "${AMBIGUOUS_PATHS[@]}"; do
      while IFS= read -r rel; do
        [[ -n "$rel" ]] && printf '%s\t%s\n' "$rel" "$(sha256 "$PROJECT_ROOT/$rel")"
      done < <(enum_files "$PROJECT_ROOT" "$p")
    done | sort -u
  } > "$MANIFEST"
  echo "MANIFEST written: $MANIFEST (sha=$sha)"
}

# init: baseline manifest from current files (fresh clone / first run). No fetch;
# write-manifest records sha=unknown when no upstream SHA has been captured yet.
cmd_init() { cmd_write_manifest; }

case "${1:-scan}" in
  scan)           cmd_scan ;;
  apply-clean)    cmd_apply_clean ;;
  apply-one)      cmd_apply_one "${2:-}" ;;
  write-manifest) cmd_write_manifest ;;
  init)           cmd_init ;;
  *) echo "usage: vibe-update {scan|apply-clean|apply-one <path>|write-manifest|init}"; exit 2 ;;
esac
