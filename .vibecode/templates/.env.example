# === Database ===
POSTGRES_DB=myproject
POSTGRES_USER=myproject_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# === Test Database (postgres-test service, tmpfs) ===
TEST_DATABASE_URL=postgresql+asyncpg://test_user:test_password@postgres-test:5432/test_db

# === Backend ===
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:[FRONTEND_PORT]

# === Frontend ===
VITE_API_URL=http://localhost:[BACKEND_PORT]

# === Ports (from ports file) ===
BACKEND_PORT=[BACKEND_PORT]
FRONTEND_PORT=[FRONTEND_PORT]
TOME_PORT=[TOME_PORT]
# Postgres is NOT published by the base docker-compose.yml. Only used if you expose
# it to host GUI tools in docker-compose.override.yml ("127.0.0.1:${POSTGRES_PORT}:5432").
POSTGRES_PORT=[POSTGRES_PORT]

# === Optional Services (uncomment when added via /plan) ===
# REDIS_URL=redis://redis:6379/0
# ELASTICSEARCH_URL=http://elasticsearch:9200
# SMTP_HOST=mailhog
# SMTP_PORT=1025

# === External APIs (add as needed) ===
# STRIPE_SECRET_KEY=sk_test_...
# SENDGRID_API_KEY=SG...
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
